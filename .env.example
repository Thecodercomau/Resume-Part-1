# Copy to .env and fill in your MySQL credentials.
# (Requires python-dotenv, which is in requirements.txt.)

# Database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resume
DB_POOL_SIZE=5

# Set to 0 if your MySQL server requires a TLS connection.
DB_SSL_DISABLED=1

# Token required in the X-Admin-Token header for write endpoints.
# Leave unset for local development; always set it in production.
# ADMIN_TOKEN=change-me

# Port Flask listens on
# PORT=5000
